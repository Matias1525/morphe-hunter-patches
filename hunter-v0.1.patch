+package app.morphe.extension.shared.patches;
+
+import androidx.annotation.Nullable;
+
+import java.text.Normalizer;
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Diagnostic bridge used by YouTube Hunter to inspect and correlate the real player audio-track model.
+ *
+ * v0.2.0 binds audioTracks[] to YouTube's authoritative current-playing video ID supplied by
+ * VideoInformation.setVideoId(). Player-response IDs are recorded as secondary diagnostics only,
+ * because YouTube can prefetch a different response while the current player remains unchanged.
+ */
+@SuppressWarnings("unused")
+public final class HunterAudioTrackBridge {
+    private static final String ORIGINAL_AUDIO_TRACK_SUFFIX = ".4";
+    private static final int MAX_CAPTURES = 16;
+    private static final int MAX_STACK_FRAMES = 24;
+    private static final int MAX_CACHE_ENTRIES = 64;
+
+    private static final Object LOCK = new Object();
+    private static final Deque<String> CAPTURES = new ArrayDeque<>();
+    private static final LinkedHashMap<String, VerificationRecord> CACHE =
+            new LinkedHashMap<>(MAX_CACHE_ENTRIES + 1, 0.75f, true);
+    private static final AtomicLong CAPTURE_SEQUENCE = new AtomicLong();
+    private static final AtomicLong PLAYER_GENERATION = new AtomicLong();
+
+    private static volatile String playbackVideoId = "";
+    private static volatile long playbackVideoIdAtMs;
+    private static volatile String playerResponseVideoId = "";
+    private static volatile long playerResponseVideoIdAtMs;
+
+    private HunterAudioTrackBridge() {}
+
+    public static void onPlayerInitialize() {
+        PLAYER_GENERATION.incrementAndGet();
+        playbackVideoId = "";
+        playbackVideoIdAtMs = 0L;
+    }
+
+    public static void observePlaybackVideoId(@Nullable String videoId) {
+        if (videoId == null || videoId.isEmpty()) return;
+        playbackVideoId = videoId;
+        playbackVideoIdAtMs = System.currentTimeMillis();
+    }
+
+    public static void observePlayerResponseVideoId(@Nullable String videoId) {
+        if (videoId == null || videoId.isEmpty()) return;
+        playerResponseVideoId = videoId;
+        playerResponseVideoIdAtMs = System.currentTimeMillis();
+    }
+
+    /**
+     * Kept for compatibility with older Hunter diagnostic code.
+     * A manually supplied ID is treated as a playback ID, never as proof retroactively.
+     */
+    public static void setCurrentVideoId(@Nullable String videoId) {
+        observePlaybackVideoId(videoId);
+    }
+
+    public static void capture(@Nullable ForceOriginalAudioPatch.AudioTrackInterface[] audioTracks) {
+        if (audioTracks == null || audioTracks.length == 0) return;
+
+        final long sequence = CAPTURE_SEQUENCE.incrementAndGet();
+        final long capturedAtMs = System.currentTimeMillis();
+        final long generation = PLAYER_GENERATION.get();
+        final Thread thread = Thread.currentThread();
+
+        final String playbackId = playbackVideoId;
+        final long playbackAt = playbackVideoIdAtMs;
+        final String responseId = playerResponseVideoId;
+        final long responseAt = playerResponseVideoIdAtMs;
+
+        final boolean hasPlaybackId = playbackId != null && !playbackId.isEmpty();
+        final boolean responseMatchesPlayback =
+                hasPlaybackId && responseId != null && playbackId.equals(responseId);
+
+        final String boundVideoId = hasPlaybackId ? playbackId : "";
+        final String association = hasPlaybackId
+                ? (responseMatchesPlayback
+                    ? "PLAYBACK_ID_CONFIRMED_BY_RESPONSE"
+                    : "PLAYBACK_ID_AUTHORITATIVE")
+                : (responseId != null && !responseId.isEmpty()
+                    ? "PLAYER_RESPONSE_ONLY_UNVERIFIED"
+                    : "NO_VIDEO_ID");
+        final boolean associationVerified = hasPlaybackId;
+
+        StringBuilder out = new StringBuilder();
+        boolean hasSpanish = false;
+        boolean hasSpanishAutoDub = false;
+        boolean hasSpanishOriginal = false;
+        boolean hasSpanishManualDub = false;
+
+        out.append("captureSequence=").append(sequence).append('\n');
+        out.append("capturedAtMs=").append(capturedAtMs).append('\n');
+        out.append("playerGeneration=").append(generation).append('\n');
+        out.append("thread=")
+                .append(thread.getId())
+                .append("/")
+                .append(safe(thread.getName()))
+                .append('\n');
+        out.append("playbackVideoId=").append(emptyAsQuestion(playbackId)).append('\n');
+        out.append("playbackVideoIdAgeMs=")
+                .append(playbackAt == 0L ? -1L : Math.max(0L, capturedAtMs - playbackAt))
+                .append('\n');
+        out.append("playerResponseVideoId=").append(emptyAsQuestion(responseId)).append('\n');
+        out.append("playerResponseVideoIdAgeMs=")
+                .append(responseAt == 0L ? -1L : Math.max(0L, capturedAtMs - responseAt))
+                .append('\n');
+        out.append("association=").append(association).append('\n');
+        out.append("associationVerified=").append(associationVerified).append('\n');
+        out.append("boundVideoId=").append(emptyAsQuestion(boundVideoId)).append('\n');
+        out.append("trackCount=").append(audioTracks.length).append('\n');
+        out.append("arrayClass=").append(audioTracks.getClass().getName()).append('\n');
+
+        int index = 0;
+        for (ForceOriginalAudioPatch.AudioTrackInterface track : audioTracks) {
+            if (track == null) continue;
+
+            String id = safe(track.patch_getId());
+            String displayName = safe(track.patch_getDisplayName());
+            boolean isAutoDubbed = track.patch_getIsAutoDubbed();
+            boolean isDefault = track.patch_getIsDefault();
+            boolean isOriginalById = id.endsWith(ORIGINAL_AUDIO_TRACK_SUFFIX);
+            boolean isSpanish = isSpanishTrack(displayName, id);
+
+            if (isSpanish) {
+                hasSpanish = true;
+                if (isAutoDubbed) {
+                    hasSpanishAutoDub = true;
+                } else if (isOriginalById) {
+                    hasSpanishOriginal = true;
+                } else {
+                    hasSpanishManualDub = true;
+                }
+            }
+
+            out.append("track[").append(index++).append("]")
+                    .append(" class=").append(track.getClass().getName())
+                    .append(" objectId=").append(System.identityHashCode(track))
+                    .append(" id=").append(id)
+                    .append(" name=").append(displayName)
+                    .append(" isAutoDubbed=").append(isAutoDubbed)
+                    .append(" isDefault=").append(isDefault)
+                    .append(" originalById=").append(isOriginalById)
+                    .append(" spanish=").append(isSpanish)
+                    .append('\n');
+        }
+
+        String classification;
+        if (hasSpanishAutoDub) {
+            classification = "AUTO_DUB_ES";
+        } else if (hasSpanishOriginal) {
+            classification = "ORIGINAL_ES";
+        } else if (hasSpanishManualDub) {
+            classification = "DUBBED_ES";
+        } else if (hasSpanish) {
+            classification = "SPANISH_TRACK";
+        } else {
+            classification = "NO_ES_TRACK";
+        }
+
+        String verificationState = associationVerified
+                ? "VERIFIED_" + classification
+                : "UNBOUND_" + classification;
+
+        out.append("classification=").append(classification).append('\n');
+        out.append("verificationState=").append(verificationState).append('\n');
+        appendCallStack(out, thread.getStackTrace());
+
+        synchronized (LOCK) {
+            CAPTURES.addLast(out.toString());
+            while (CAPTURES.size() > MAX_CAPTURES) {
+                CAPTURES.removeFirst();
+            }
+
+            if (associationVerified) {
+                CACHE.put(
+                        boundVideoId,
+                        new VerificationRecord(
+                                boundVideoId,
+                                classification,
+                                verificationState,
+                                association,
+                                capturedAtMs,
+                                generation,
+                                audioTracks.length
+                        )
+                );
+                trimCache();
+            }
+        }
+    }
+
+    public static boolean hasCapture() {
+        synchronized (LOCK) {
+            return !CAPTURES.isEmpty();
+        }
+    }
+
+    @Nullable
+    public static String getVerifiedClassification(@Nullable String videoId) {
+        if (videoId == null || videoId.isEmpty()) return null;
+        synchronized (LOCK) {
+            VerificationRecord record = CACHE.get(videoId);
+            return record == null ? null : record.classification;
+        }
+    }
+
+    public static boolean isVerifiedAutoDubSpanish(@Nullable String videoId) {
+        return "AUTO_DUB_ES".equals(getVerifiedClassification(videoId));
+    }
+
+    public static String exportText() {
+        synchronized (LOCK) {
+            StringBuilder out = new StringBuilder();
+
+            if (CAPTURES.isEmpty()) {
+                out.append("No player audio-track snapshot captured.\n");
+            } else {
+                out.append("captureCount=").append(CAPTURES.size()).append('\n');
+                for (String capture : CAPTURES) {
+                    out.append("\n------------------------------------------------------------\n");
+                    out.append(capture);
+                }
+            }
+
+            out.append("\n============================================================\n");
+            out.append("VERIFIED AUDIO CACHE\n");
+            out.append("============================================================\n");
+            out.append("cacheCount=").append(CACHE.size()).append('\n');
+            for (Map.Entry<String, VerificationRecord> entry : CACHE.entrySet()) {
+                VerificationRecord record = entry.getValue();
+                out.append("videoId=").append(record.videoId)
+                        .append(" classification=").append(record.classification)
+                        .append(" verificationState=").append(record.verificationState)
+                        .append(" association=").append(record.association)
+                        .append(" capturedAtMs=").append(record.capturedAtMs)
+                        .append(" playerGeneration=").append(record.playerGeneration)
+                        .append(" trackCount=").append(record.trackCount)
+                        .append('\n');
+            }
+
+            return out.toString();
+        }
+    }
+
+    /**
+     * Clears diagnostic history and verified cache but intentionally retains the current
+     * player IDs. Clearing a log while a video is already open must not destroy correlation.
+     */
+    public static void clear() {
+        CAPTURE_SEQUENCE.set(0L);
+        synchronized (LOCK) {
+            CAPTURES.clear();
+            CACHE.clear();
+        }
+    }
+
+    private static void appendCallStack(StringBuilder out, StackTraceElement[] stackTrace) {
+        out.append("callStack:\n");
+        int written = 0;
+
+        for (StackTraceElement frame : stackTrace) {
+            if (frame == null) continue;
+
+            String className = frame.getClassName();
+            if (className.equals(Thread.class.getName())
+                    || className.equals(HunterAudioTrackBridge.class.getName())) {
+                continue;
+            }
+
+            out.append("  #").append(written)
+                    .append(" ")
+                    .append(className)
+                    .append(".")
+                    .append(frame.getMethodName())
+                    .append("(")
+                    .append(frame.getFileName() == null ? "Unknown Source" : frame.getFileName())
+                    .append(":")
+                    .append(frame.getLineNumber())
+                    .append(")")
+                    .append('\n');
+
+            written++;
+            if (written >= MAX_STACK_FRAMES) break;
+        }
+    }
+
+    private static boolean isSpanishTrack(String displayName, String id) {
+        String normalizedName = normalize(displayName);
+        String normalizedId = normalize(id);
+
+        return normalizedName.contains("espanol")
+                || normalizedName.contains("spanish")
+                || normalizedName.startsWith("es ")
+                || normalizedName.startsWith("es(")
+                || normalizedId.equals("es")
+                || normalizedId.startsWith("es-")
+                || normalizedId.startsWith("es_")
+                || normalizedId.contains(".es.");
+    }
+
+    private static String normalize(String value) {
+        if (value == null) return "";
+        String normalized = Normalizer.normalize(value, Normalizer.Form.NFD)
+                .replaceAll("\\p{M}+", "");
+        return normalized.toLowerCase(Locale.ROOT).trim();
+    }
+
+    private static String safe(String value) {
+        return value == null ? "" : value.replace('\n', ' ').replace('\r', ' ');
+    }
+
+    private static String emptyAsQuestion(String value) {
+        return value == null || value.isEmpty() ? "?" : value;
+    }
+
+    private static void trimCache() {
+        while (CACHE.size() > MAX_CACHE_ENTRIES) {
+            String eldestKey = CACHE.keySet().iterator().next();
+            CACHE.remove(eldestKey);
+        }
+    }
+
+    private static final class VerificationRecord {
+        final String videoId;
+        final String classification;
+        final String verificationState;
+        final String association;
+        final long capturedAtMs;
+        final long playerGeneration;
+        final int trackCount;
+
+        VerificationRecord(
+                String videoId,
+                String classification,
+                String verificationState,
+                String association,
+                long capturedAtMs,
+                long playerGeneration,
+                int trackCount
+        ) {
+            this.videoId = videoId;
+            this.classification = classification;
+            this.verificationState = verificationState;
+            this.association = association;
+            this.capturedAtMs = capturedAtMs;
+            this.playerGeneration = playerGeneration;
+            this.trackCount = trackCount;
+        }
+    }
+}
+
