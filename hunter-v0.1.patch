diff --git a/extensions/shared-youtube/library/src/main/java/app/morphe/extension/shared/patches/HunterAudioTrackBridge.java b/extensions/shared-youtube/library/src/main/java/app/morphe/extension/shared/patches/HunterAudioTrackBridge.java
