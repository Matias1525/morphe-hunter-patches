+package app.morphe.extension.youtube.settings.preference;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.content.Intent;
+import android.preference.Preference;
+import android.preference.PreferenceGroup;
+import android.preference.PreferenceScreen;
+import android.view.View;
+import android.widget.ListAdapter;
+import android.widget.ListView;
+import android.widget.Toolbar;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.patches.GmsCoreSupportPatch;
+import app.morphe.extension.shared.settings.SharedYouTubeSettings;
+import app.morphe.extension.shared.settings.preference.ToolbarPreferenceFragment;
+import app.morphe.extension.youtube.settings.YouTubeActivityHook;
+
+/**
+ * Preference fragment for Morphe settings.
+ */
+@SuppressWarnings("deprecation")
+public class YouTubePreferenceFragment extends ToolbarPreferenceFragment {
+    private static final String HUNTER_SETTINGS_SCREEN_EXTRA = "morphe_hunter_settings_screen";
+
+    /**
+     * The main PreferenceScreen used to display the current set of preferences.
+     */
+    private PreferenceScreen preferenceScreen;
+
+    /**
+     * Initializes the preference fragment.
+     */
+    @Override
+    protected void initialize() {
+        super.initialize();
+
+        try {
+            preferenceScreen = getPreferenceScreen();
+            sortPreferenceGroups(preferenceScreen);
+            setPreferenceScreenToolbar(preferenceScreen);
+
+            // Clunky work around until preferences are custom classes that manage themselves.
+            // A mount (root) install has its branding applied while patching and cannot change
+            // it at runtime. But the preferences must be added during patching because of
+            // difficulties detecting during patching if it's a root installation. So instead
+            // the non-functional preferences are removed during runtime.
+            if (GmsCoreSupportPatch.isPackageNameOriginal()) {
+                removePreferences(
+                        SharedYouTubeSettings.CUSTOM_BRANDING_ICON.key,
+                        SharedYouTubeSettings.CUSTOM_BRANDING_NOTIFICATION_ICON.key,
+                        SharedYouTubeSettings.CUSTOM_BRANDING_NAME.key);
+            }
+        } catch (Exception ex) {
+            Logger.printException(() -> "initialize failure", ex);
+        }
+    }
+
+    /**
+     * Called when the fragment starts.
+     */
+    @Override
+    public void onStart() {
+        super.onStart();
+        try {
+            // Initialize search controller if needed.
+            if (YouTubeActivityHook.searchViewController != null) {
+                // Trigger search data collection after fragment is ready.
+                YouTubeActivityHook.searchViewController.initializeSearchData();
+            }
+
+            Activity activity = getActivity();
+            if (activity != null) {
+                Intent intent = activity.getIntent();
+                String requestedScreen = intent.getStringExtra(HUNTER_SETTINGS_SCREEN_EXTRA);
+                if (requestedScreen != null && !requestedScreen.isEmpty()) {
+                    intent.removeExtra(HUNTER_SETTINGS_SCREEN_EXTRA);
+                    ListView rootList = getListView();
+                    if (rootList != null) {
+                        rootList.post(() -> openPreferenceScreenPath(requestedScreen));
+                    }
+                }
+            }
+        } catch (Exception ex) {
+            Logger.printException(() -> "onStart failure", ex);
+        }
+    }
+
+    private void openPreferenceScreenPath(String targetKey) {
+        try {
+            Preference target = findPreference(targetKey);
+            PreferenceScreen root = getPreferenceScreen();
+            if (!(target instanceof PreferenceScreen) || root == null) {
+                Logger.printDebug(() -> "Hunter shortcut target not found: " + targetKey);
+                return;
+            }
+
+            List<PreferenceScreen> path = new ArrayList<>();
+            if (!findPreferenceScreenPath(root, target, path) || path.isEmpty()) {
+                Logger.printDebug(() -> "Hunter shortcut path not found: " + targetKey);
+                return;
+            }
+
+            openPreferenceScreenPathStep(path, 0, getListView());
+        } catch (Exception ex) {
+            Logger.printException(() -> "openPreferenceScreenPath failure", ex);
+        }
+    }
+
+    private static boolean findPreferenceScreenPath(
+            PreferenceGroup group,
+            Preference target,
+            List<PreferenceScreen> path
+    ) {
+        for (int i = 0, count = group.getPreferenceCount(); i < count; i++) {
+            Preference child = group.getPreference(i);
+
+            if (child == target) {
+                if (child instanceof PreferenceScreen screen) {
+                    path.add(screen);
+                    return true;
+                }
+                return false;
+            }
+
+            if (child instanceof PreferenceGroup childGroup) {
+                boolean addedScreen = child instanceof PreferenceScreen;
+                if (addedScreen) {
+                    path.add((PreferenceScreen) child);
+                }
+
+                if (findPreferenceScreenPath(childGroup, target, path)) {
+                    return true;
+                }
+
+                if (addedScreen) {
+                    path.remove(path.size() - 1);
+                }
+            }
+        }
+
+        return false;
+    }
+
+    private void openPreferenceScreenPathStep(
+            List<PreferenceScreen> path,
+            int index,
+            ListView parentList
+    ) {
+        if (parentList == null || index >= path.size()) return;
+
+        PreferenceScreen screen = path.get(index);
+        ListAdapter adapter = parentList.getAdapter();
+        if (adapter == null) {
+            Logger.printDebug(() -> "Hunter shortcut adapter missing at step " + index);
+            return;
+        }
+
+        int position = findPreferencePosition(adapter, screen);
+        if (position < 0) {
+            Logger.printDebug(() -> "Hunter shortcut preference missing from adapter at step " + index);
+            return;
+        }
+
+        parentList.setSelection(position);
+        parentList.post(() -> {
+            try {
+                ListAdapter currentAdapter = parentList.getAdapter();
+                if (currentAdapter == null || position >= currentAdapter.getCount()) return;
+
+                int childIndex = position - parentList.getFirstVisiblePosition();
+                View row = childIndex >= 0 && childIndex < parentList.getChildCount()
+                        ? parentList.getChildAt(childIndex)
+                        : currentAdapter.getView(position, null, parentList);
+
+                parentList.performItemClick(
+                        row,
+                        position,
+                        currentAdapter.getItemId(position)
+                );
+
+                parentList.postDelayed(() -> {
+                    Dialog dialog = screen.getDialog();
+                    if (dialog == null) {
+                        Logger.printDebug(() -> "Hunter shortcut dialog missing at step " + index);
+                        return;
+                    }
+
+                    if (index + 1 < path.size()) {
+                        ListView nestedList = dialog.findViewById(android.R.id.list);
+                        if (nestedList == null) {
+                            Logger.printDebug(() -> "Hunter shortcut nested list missing at step " + index);
+                            return;
+                        }
+                        nestedList.post(() ->
+                                openPreferenceScreenPathStep(path, index + 1, nestedList)
+                        );
+                    }
+                }, 80);
+            } catch (Exception ex) {
+                Logger.printException(() -> "Hunter shortcut step failure", ex);
+            }
+        });
+    }
+
+    private static int findPreferencePosition(ListAdapter adapter, Preference target) {
+        for (int i = 0, count = adapter.getCount(); i < count; i++) {
+            Object item = adapter.getItem(i);
+            if (item == target) return i;
+            if (item instanceof Preference pref
+                    && target.getKey() != null
+                    && target.getKey().equals(pref.getKey())) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    /**
+     * Sets toolbar for all nested preference screens.
+     */
+    @Override
+    protected void customizeToolbar(Toolbar toolbar) {
+        YouTubeActivityHook.setToolbarLayoutParams(toolbar);
+    }
+
+    /**
+     * Perform actions after toolbar setup.
+     */
+    @Override
+    protected void onPostToolbarSetup(Toolbar toolbar, Dialog preferenceScreenDialog) {
+        if (YouTubeActivityHook.searchViewController != null
+                && YouTubeActivityHook.searchViewController.isSearchActive()) {
+            toolbar.post(() -> YouTubeActivityHook.searchViewController.closeSearch());
+        }
+    }
+
+    /**
+     * Returns the preference screen for external access by SearchViewController.
+     */
+    public PreferenceScreen getPreferenceScreenForSearch() {
+        return preferenceScreen;
+    }
+}
