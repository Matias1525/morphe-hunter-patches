+package app.morphe.extension.youtube.patches.components;
+
+import java.text.SimpleDateFormat;
+import java.util.ArrayDeque;
+import java.util.Date;
+import java.util.Deque;
+import java.util.Locale;
+import java.util.concurrent.atomic.AtomicLong;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.patches.HunterAudioTrackBridge;
+
+/**
+ * Dedicated ring-buffer trace for YouTube Hunter.
+ * This intentionally stays separate from Morphe's global debug log so a test run
+ * can be exported without unrelated application noise.
+ */
+@SuppressWarnings("unused")
+public final class HunterTraceLog {
+    private static final int MAX_ENTRIES = 1200;
+    private static final int MAX_ENTRY_CHARS = 5000;
+    private static final Deque<String> ENTRIES = new ArrayDeque<>();
+    private static final AtomicLong SEQUENCE = new AtomicLong();
+
+    private HunterTraceLog() {}
+
+    public static void append(String event, String details) {
+        try {
+            long seq = SEQUENCE.incrementAndGet();
+            long now = System.currentTimeMillis();
+            Thread thread = Thread.currentThread();
+            String timestamp = new SimpleDateFormat(
+                    "yyyy-MM-dd HH:mm:ss.SSS",
+                    Locale.US
+            ).format(new Date(now));
+
+            String safeDetails = details == null ? "" : details;
+            if (safeDetails.length() > MAX_ENTRY_CHARS) {
+                safeDetails = safeDetails.substring(0, MAX_ENTRY_CHARS) + "…";
+            }
+
+            String entry = "#"
+                    + seq
+                    + " "
+                    + timestamp
+                    + " thread="
+                    + thread.getId()
+                    + "/"
+                    + thread.getName()
+                    + " event="
+                    + event
+                    + "\n"
+                    + safeDetails
+                    + "\n---";
+
+            synchronized (ENTRIES) {
+                ENTRIES.addLast(entry);
+                while (ENTRIES.size() > MAX_ENTRIES) {
+                    ENTRIES.removeFirst();
+                }
+            }
+
+            final String logLine = "HUNTER_TRACE " + event + " #" + seq;
+            Logger.printDebug(() -> logLine);
+        } catch (Exception ex) {
+            Logger.printException(() -> "HunterTraceLog.append failure", ex);
+        }
+    }
+
+    public static String exportText() {
+        StringBuilder out = new StringBuilder();
+        out.append("YouTube Hunter deep trace v0.2.0\n");
+        out.append("Entries are chronological. Focus on LITHO_MATCH, AUTO_DUB_BADGE, ")
+                .append("CORRELATION_CANDIDATE, CORRELATION_SELECTED/FAIL and FILTER_DECISION.\n");
+        out.append("============================================================\n");
+
+        synchronized (ENTRIES) {
+            for (String entry : ENTRIES) {
+                out.append(entry).append('\n');
+            }
+        }
+
+        out.append("\n============================================================\n");
+        out.append("REAL PLAYER AUDIO TRACK MODEL\n");
+        out.append("============================================================\n");
+        out.append(HunterAudioTrackBridge.exportText());
+
+        return out.toString();
+    }
+
+    public static void clear() {
+        synchronized (ENTRIES) {
+            ENTRIES.clear();
+        }
+        SEQUENCE.set(0);
+        HunterAudioTrackBridge.clear();
+    }
+
+    public static int size() {
+        synchronized (ENTRIES) {
+            return ENTRIES.size() + (HunterAudioTrackBridge.hasCapture() ? 1 : 0);
+        }
+    }
+}
+
