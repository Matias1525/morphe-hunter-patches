+package app.morphe.extension.youtube.settings.preference;
+
+import android.content.Context;
+import android.preference.Preference;
+import android.util.AttributeSet;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.Utils;
+import app.morphe.extension.shared.settings.preference.AbstractPreferenceFragment;
+import app.morphe.extension.shared.patches.HunterAudioTrackBridge;
+import app.morphe.extension.youtube.patches.VideoInformation;
+import app.morphe.extension.youtube.patches.components.HunterTraceLog;
+
+/**
+ * Export/clear controls for the dedicated Hunter trace.
+ * Behavior is selected by the preference key so one implementation handles both buttons.
+ */
+@SuppressWarnings({"unused", "deprecation"})
+public class HunterTracePreference extends Preference implements Preference.OnPreferenceClickListener {
+
+    public HunterTracePreference(Context context, AttributeSet attrs, int defStyleAttr, int defStyleRes) {
+        super(context, attrs, defStyleAttr, defStyleRes);
+        init();
+    }
+
+    public HunterTracePreference(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        init();
+    }
+
+    public HunterTracePreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        init();
+    }
+
+    public HunterTracePreference(Context context) {
+        super(context);
+        init();
+    }
+
+    private void init() {
+        setOnPreferenceClickListener(this);
+    }
+
+    @Override
+    public boolean onPreferenceClick(Preference preference) {
+        try {
+            String key = preference.getKey();
+            if ("morphe_hunter_clear_trace".equals(key)) {
+                HunterTraceLog.clear();
+                Utils.showToastShort("Hunter: registro de depuración limpiado");
+                return true;
+            }
+
+            HunterAudioTrackBridge.setCurrentVideoId(VideoInformation.getVideoId());
+            String text = HunterTraceLog.exportText();
+            if (HunterTraceLog.size() == 0) {
+                Utils.showToastShort("Hunter: no hay eventos para exportar");
+                return true;
+            }
+
+            AbstractPreferenceFragment fragment = AbstractPreferenceFragment.instance.get();
+            if (fragment == null) {
+                Utils.showToastShort("Hunter: no se pudo abrir el selector de archivo");
+                return true;
+            }
+
+            fragment.exportTextActivity(
+                    AbstractPreferenceFragment.exportFileName("Hunter_Trace"),
+                    text,
+                    success -> Utils.showToastLong(
+                            success
+                                    ? "Hunter: log TXT exportado"
+                                    : "Hunter: falló la exportación del log"
+                    )
+            );
+        } catch (Exception ex) {
+            Logger.printException(() -> "HunterTracePreference failure", ex);
+            Utils.showToastShort("Hunter: error al exportar el log");
+        }
+        return true;
+    }
+}
