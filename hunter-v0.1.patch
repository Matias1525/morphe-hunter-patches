+/*
+ * YouTube Hunter experimental filter for Morphe.
+ * Diagnostic-first implementation: search results only.
+ */
+package app.morphe.extension.youtube.patches.components;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.patches.HunterAudioTrackBridge;
+import app.morphe.extension.shared.patches.components.BufferAsciiStrings;
+import app.morphe.extension.shared.patches.components.BufferPhraseFilter;
+import app.morphe.extension.shared.patches.components.ContextInterface;
+import app.morphe.extension.shared.patches.components.Filter;
+import app.morphe.extension.shared.patches.components.StringFilterGroup;
+import app.morphe.extension.youtube.settings.Settings;
+import app.morphe.extension.youtube.shared.NavigationBar;
+
+/**
+ * Experimental YouTube Hunter filter.
+ *
+ * v0.2.0 goals:
+ * - Keep duration and Shorts filtering local and realtime.
+ * - Observe Morphe's |badge.e auto-dub signal.
+ * - Correlate child auto-dub badges to recently rendered search cards using the
+ *   actual Litho component path, preferring exact parent-path containment.
+ * - Capture deep Litho traces from Search, Home/feed and Player surfaces.
+ * - Keep filtering limited to Search while diagnostics observe all relevant surfaces.
+ * - Treat only a real badge component as auto-dub evidence; never generic card-buffer icons.
+ * - Keep audio filtering fail-open until path correlation is proven on-device.
+ */
+@SuppressWarnings("unused")
+public final class HunterFilter extends Filter {
+    private static final String TAG = "HUNTER";
+    private static final long RECENT_CARD_TTL_MS = 2500L;
+    private static final int MAX_RECENT_CARDS = 16;
+
+    private final StringFilterGroup searchCards = new StringFilterGroup(
+            Settings.HUNTER_ENABLED,
+            "search_video_with_context.e",
+            "video_lockup_with_attachment.e",
+            "compact_video.e",
+            "inline_shorts",
+            "shorts_video_cell",
+            "shorts_pivot_item.e",
+            "shorts_lockup_cell.e",
+            "video_card.e"
+    );
+
+    private final StringFilterGroup autoDubBadges = new StringFilterGroup(
+            Settings.HUNTER_ENABLED,
+            "|badge.e"
+    );
+
+    // Deep trace only. These components are observed but never filtered by this group.
+    // They reveal the actual YouTube/Litho sequence around result cards, metadata,
+    // badges and audio-related UI without tracing the entire application.
+    private final StringFilterGroup traceComponents = new StringFilterGroup(
+            Settings.HUNTER_DEBUG_LOGS,
+            "metadata.e",
+            "thumbnail.e",
+            "video_metadata.eml",
+            "video-description-ep-identifier",
+            "audio_track",
+            "audio_track_sheet_content"
+    );
+
+    private static final ConcurrentHashMap<String, Boolean> AUTO_DUB_BY_VIDEO_ID =
+            new ConcurrentHashMap<>();
+    private static final ThreadLocal<Deque<RecentCard>> RECENT_SEARCH_CARDS =
+            ThreadLocal.withInitial(ArrayDeque::new);
+
+    private static final Pattern DURATION_TOKEN = Pattern.compile(
+            "(?<![0-9])(?:(\\d{1,2}):)?([0-5]?\\d):([0-5]\\d)(?![0-9])"
+    );
+
+    private static final String[] SHORT_MARKERS = {
+            "inline_shorts",
+            "shorts_video_cell",
+            "shorts_pivot_item.e",
+            "shorts_lockup_cell.e",
+            "shorts-lockup-image",
+            "/shorts/"
+    };
+
+    private static final String[] AUTO_DUB_MARKERS = {
+            "yt_outline_person_radar",
+            "yt_outline_experimental_person_waves"
+    };
+
+    public HunterFilter() {
+        addPathCallbacks(searchCards, autoDubBadges, traceComponents);
+    }
+
+    @Override
+    public boolean isFiltered(ContextInterface contextInterface,
+                              String identifier,
+                              String accessibility,
+                              String path,
+                              byte[] buffer,
+                              BufferAsciiStrings asciiStrings,
+                              StringFilterGroup matchedGroup,
+                              FilterContentType contentType,
+                              int contentIndex) {
+        if (!Settings.HUNTER_ENABLED.get()) return false;
+
+        final String ascii = asciiStrings.getStrings();
+        final String decoded = new String(buffer, StandardCharsets.UTF_8);
+        final String directVideoId = BufferPhraseFilter.extractVideoIdFromBuffer(buffer);
+        final boolean searchSurface = NavigationBar.isSearchBarActive();
+        final String surface = searchSurface
+                ? "SEARCH"
+                : detectNonSearchSurface(path, ascii, accessibility);
+
+        if ("PLAYER".equals(surface) && directVideoId != null) {
+            HunterAudioTrackBridge.setCurrentVideoId(directVideoId);
+        }
+
+        // Diagnostics intentionally run BEFORE the Search-only filtering gate.
+        // This is required because YouTube renders the visible auto-dub badge in Home/feed,
+        // while Search does not necessarily render that label at all.
+        if (Settings.HUNTER_DEBUG_LOGS.get()) {
+            HunterTraceLog.append(
+                    "LITHO_MATCH",
+                    "surface=" + surface
+                            + "\ngroup=" + groupName(matchedGroup)
+                            + "\ncontentType=" + contentType
+                            + "\ncontentIndex=" + contentIndex
+                            + "\nidentifier=" + identifier
+                            + "\nvideoId=" + (directVideoId == null ? "?" : directVideoId)
+                            + "\npath=" + path
+                            + "\naccessibility=" + traceText(accessibility, 700)
+                            + "\nascii=" + traceText(ascii, 2200)
+            );
+        }
+
+        if (matchedGroup == autoDubBadges) {
+            observeAutoDubBadge(surface, path, accessibility, ascii, decoded, directVideoId);
+            return false;
+        }
+
+        if (matchedGroup == traceComponents) {
+            return false;
+        }
+
+        // Hunter filtering remains Search-only. Home/feed and Player are observation-only.
+        if (!searchSurface) return false;
+
+        if (contentIndex != 0) return false;
+
+        if (directVideoId != null) {
+            rememberSearchCard(directVideoId, path);
+        }
+
+        // Do NOT infer auto-dub from generic icon names inside a card buffer.
+        // Those buffers contain shared YouTube resource catalogs and caused false positives.
+        final boolean autoDub = directVideoId != null
+                && Boolean.TRUE.equals(AUTO_DUB_BY_VIDEO_ID.get(directVideoId));
+        final boolean isShort = containsAny(path, SHORT_MARKERS)
+                || containsAny(ascii, SHORT_MARKERS);
+        final int durationSeconds = extractLongestDurationSeconds(
+                ascii + "❙" + accessibility
+        );
+        final int minDurationSeconds = parseMinDurationSeconds();
+
+        if (Settings.HUNTER_DEBUG_LOGS.get()) {
+            Logger.printDebug(() -> TAG
+                    + " search-card id=" + (directVideoId == null ? "?" : directVideoId)
+                    + " duration=" + durationSeconds
+                    + "s autoDubAssociated=" + autoDub
+                    + " short=" + isShort
+                    + " path=" + path
+                    + " accessibility=" + truncate(accessibility, 220)
+                    + " ascii=" + truncate(ascii, 900));
+        }
+
+        if (Settings.HUNTER_HIDE_SHORTS.get() && isShort) {
+            Logger.printDebug(() -> TAG + " hide short id=" + directVideoId);
+            traceDecision(directVideoId, "HIDE", "short", autoDub, durationSeconds, path);
+            return true;
+        }
+
+        if (minDurationSeconds > 0
+                && durationSeconds >= 0
+                && durationSeconds < minDurationSeconds) {
+            Logger.printDebug(() -> TAG
+                    + " hide duration id=" + directVideoId
+                    + " duration=" + durationSeconds);
+            traceDecision(directVideoId, "HIDE", "duration", autoDub, durationSeconds, path);
+            return true;
+        }
+
+        if (Settings.HUNTER_REQUIRE_AUTO_DUB.get()) {
+            if (directVideoId == null) {
+                Logger.printDebug(() -> TAG
+                        + " auto-dub unknown: card has no video id; keeping");
+                return false;
+            }
+            if (autoDub) {
+                Logger.printDebug(() -> TAG
+                        + " keep verified auto-dub id=" + directVideoId);
+                traceDecision(directVideoId, "KEEP", "auto_dub_associated", true, durationSeconds, path);
+                return false;
+            }
+
+            Logger.printDebug(() -> TAG
+                    + " auto-dub not associated yet id=" + directVideoId
+                    + "; keeping in diagnostic v0.2.0");
+        }
+
+        traceDecision(directVideoId, "KEEP", "no_destructive_match", autoDub, durationSeconds, path);
+        return false;
+    }
+
+    private static void rememberSearchCard(String videoId, String path) {
+        Deque<RecentCard> cards = RECENT_SEARCH_CARDS.get();
+        long now = System.currentTimeMillis();
+        pruneRecentCards(cards, now);
+
+        cards.removeIf(card -> videoId.equals(card.videoId));
+        cards.addLast(new RecentCard(videoId, path, now));
+
+        if (Settings.HUNTER_DEBUG_LOGS.get()) {
+            HunterTraceLog.append(
+                    "CARD_REMEMBER",
+                    "videoId=" + videoId
+                            + "\npath=" + path
+                            + "\nrecentCount=" + cards.size()
+            );
+        }
+
+        while (cards.size() > MAX_RECENT_CARDS) {
+            cards.removeFirst();
+        }
+    }
+
+    private static void observeAutoDubBadge(String surface,
+                                            String path,
+                                            String accessibility,
+                                            String ascii,
+                                            String decoded,
+                                            String directVideoId) {
+        final boolean radar = containsAny(ascii, AUTO_DUB_MARKERS)
+                || containsAny(decoded, AUTO_DUB_MARKERS);
+        if (!radar) return;
+
+        String resolvedVideoId = directVideoId;
+        String associationSource = "badge-buffer";
+        RecentCard matchedCard = null;
+
+        if (Settings.HUNTER_DEBUG_LOGS.get()) {
+            HunterTraceLog.append(
+                    "AUTO_DUB_BADGE",
+                    "surface=" + surface
+                            + "\ndirectVideoId=" + (directVideoId == null ? "?" : directVideoId)
+                            + "\nbadgePath=" + path
+                            + "\naccessibility=" + traceText(accessibility, 700)
+                            + "\nascii=" + traceText(ascii, 2200)
+            );
+        }
+
+        if (resolvedVideoId == null) {
+            Deque<RecentCard> cards = RECENT_SEARCH_CARDS.get();
+            long now = System.currentTimeMillis();
+            pruneRecentCards(cards, now);
+
+            if (Settings.HUNTER_DEBUG_LOGS.get()) {
+                for (RecentCard candidate : cards) {
+                    int candidateScore = pathMatchScore(candidate.path, path);
+                    HunterTraceLog.append(
+                            "CORRELATION_CANDIDATE",
+                            "surface=" + surface
+                                    + "\nvideoId=" + candidate.videoId
+                                    + "\nscore=" + candidateScore
+                                    + "\ncardPath=" + candidate.path
+                                    + "\nbadgePath=" + path
+                    );
+                }
+            }
+
+            matchedCard = findBestPathMatch(cards, path);
+            if (matchedCard != null) {
+                resolvedVideoId = matchedCard.videoId;
+                associationSource = "litho-path-parent";
+            }
+        }
+
+        final String finalVideoId = resolvedVideoId;
+        final String finalAssociationSource = associationSource;
+        final RecentCard finalMatchedCard = matchedCard;
+
+        if (finalVideoId != null) {
+            markAutoDub(finalVideoId, finalAssociationSource);
+        }
+
+        if (Settings.HUNTER_DEBUG_LOGS.get()) {
+            Logger.printDebug(() -> TAG
+                    + " badge radar=true id="
+                    + (finalVideoId == null ? "?" : finalVideoId)
+                    + " source=" + finalAssociationSource
+                    + " cardPath=" + (finalMatchedCard == null ? "?" : finalMatchedCard.path)
+                    + " badgePath=" + path
+                    + " accessibility=" + truncate(accessibility, 220)
+                    + " ascii=" + truncate(ascii, 900));
+
+            HunterTraceLog.append(
+                    finalVideoId == null ? "CORRELATION_FAIL" : "CORRELATION_SELECTED",
+                    "surface=" + surface
+                            + "\nvideoId=" + (finalVideoId == null ? "?" : finalVideoId)
+                            + "\nsource=" + finalAssociationSource
+                            + "\ncardPath=" + (finalMatchedCard == null ? "?" : finalMatchedCard.path)
+                            + "\nbadgePath=" + path
+                            + "\ncardFingerprint=" + pathFingerprint(finalMatchedCard == null ? null : finalMatchedCard.path)
+                            + "\nbadgeFingerprint=" + pathFingerprint(path)
+            );
+        }
+    }
+
+    private static RecentCard findBestPathMatch(Deque<RecentCard> cards, String badgePath) {
+        if (badgePath == null || badgePath.isEmpty()) return null;
+
+        RecentCard best = null;
+        int bestScore = -1;
+
+        for (RecentCard card : cards) {
+            if (card.path == null || card.path.isEmpty()) continue;
+
+            int score = pathMatchScore(card.path, badgePath);
+            if (score > bestScore) {
+                best = card;
+                bestScore = score;
+            }
+        }
+
+        return bestScore > 0 ? best : null;
+    }
+
+    private static int pathMatchScore(String cardPath, String badgePath) {
+        if (badgePath.startsWith(cardPath)) {
+            return 100000 + cardPath.length();
+        }
+
+        String family = searchCardFamily(cardPath);
+        if (family == null || !badgePath.contains(family)) {
+            return -1;
+        }
+
+        int common = commonPrefixLength(cardPath, badgePath);
+        return 1000 + common;
+    }
+
+    private static int commonPrefixLength(String a, String b) {
+        int max = Math.min(a.length(), b.length());
+        int i = 0;
+        while (i < max && a.charAt(i) == b.charAt(i)) {
+            i++;
+        }
+        return i;
+    }
+
+    private static void pruneRecentCards(Deque<RecentCard> cards, long now) {
+        while (!cards.isEmpty()) {
+            RecentCard first = cards.peekFirst();
+            if (first == null || now - first.seenAtMs <= RECENT_CARD_TTL_MS) {
+                break;
+            }
+            cards.removeFirst();
+        }
+    }
+
+    private static void markAutoDub(String videoId, String source) {
+        Boolean previous = AUTO_DUB_BY_VIDEO_ID.putIfAbsent(videoId, true);
+        if (previous != null) return;
+
+        Logger.printDebug(() -> TAG
+                + " auto-dub associated id=" + videoId
+                + " source=" + source);
+
+        if (Settings.HUNTER_DEBUG_LOGS.get()) {
+            HunterTraceLog.append(
+                    "AUTO_DUB_ASSOCIATED",
+                    "videoId=" + videoId + "\nsource=" + source
+            );
+        }
+    }
+
+    private static String pathFingerprint(String path) {
+        if (path == null || path.isEmpty()) return "?";
+        int hash = path.hashCode();
+        String family = searchCardFamily(path);
+        String familyLabel = family == null ? "none" : family;
+        return familyLabel + ":" + Integer.toHexString(hash);
+    }
+
+    private static String searchCardFamily(String path) {
+        if (path == null) return null;
+        String[] families = {
+                "search_video_with_context.e",
+                "video_lockup_with_attachment.e",
+                "compact_video.e",
+                "inline_shorts",
+                "shorts_video_cell",
+                "shorts_pivot_item.e",
+                "shorts_lockup_cell.e",
+                "video_card.e"
+        };
+        for (String family : families) {
+            if (path.contains(family)) return family;
+        }
+        return null;
+    }
+
+    private static int parseMinDurationSeconds() {
+        try {
+            String raw = Settings.HUNTER_MIN_DURATION_MINUTES.get().trim();
+            if (raw.isEmpty()) return 0;
+            int minutes = Integer.parseInt(raw);
+            if (minutes <= 0) return 0;
+            return Math.min(minutes, 24 * 60) * 60;
+        } catch (Exception ignored) {
+            return 0;
+        }
+    }
+
+    private static int extractLongestDurationSeconds(String text) {
+        Matcher matcher = DURATION_TOKEN.matcher(text);
+        int longest = -1;
+        while (matcher.find()) {
+            try {
+                int hours = matcher.group(1) == null
+                        ? 0
+                        : Integer.parseInt(matcher.group(1));
+                int minutes = Integer.parseInt(matcher.group(2));
+                int seconds = Integer.parseInt(matcher.group(3));
+                int total = hours * 3600 + minutes * 60 + seconds;
+                if (total > longest) longest = total;
+            } catch (NumberFormatException ignored) {
+                // Keep scanning.
+            }
+        }
+        return longest;
+    }
+
+    private static boolean containsAny(String text, String[] markers) {
+        if (text == null || text.isEmpty()) return false;
+        for (String marker : markers) {
+            if (text.contains(marker)) return true;
+        }
+        return false;
+    }
+
+    private static String truncate(String value, int max) {
+        if (value == null) return "";
+        String normalized = value.replace('\n', ' ');
+        return normalized.length() <= max
+                ? normalized
+                : normalized.substring(0, max) + "…";
+    }
+
+    private static String detectNonSearchSurface(String path,
+                                                 String ascii,
+                                                 String accessibility) {
+        String combined = (path == null ? "" : path)
+                + "❙"
+                + (ascii == null ? "" : ascii)
+                + "❙"
+                + (accessibility == null ? "" : accessibility);
+
+        if (combined.contains("watch")
+                || combined.contains("player")
+                || combined.contains("video_metadata.eml")
+                || combined.contains("audio_track")
+                || combined.contains("audio_track_sheet_content")) {
+            return "PLAYER";
+        }
+
+        if (combined.contains("browse")
+                || combined.contains("rich_grid")
+                || combined.contains("home")
+                || combined.contains("feed")
+                || combined.contains("video_card")
+                || combined.contains("video_lockup")) {
+            return "HOME_OR_FEED";
+        }
+
+        return "OTHER";
+    }
+
+    private static String groupName(StringFilterGroup group) {
+        if (group == null) return "null";
+        return group.filters.toString();
+    }
+
+    private static String traceText(String value, int max) {
+        if (value == null) return "";
+        String normalized = value.replace('\n', ' ').replace('\r', ' ');
+        return normalized.length() <= max
+                ? normalized
+                : normalized.substring(0, max) + "…";
+    }
+
+    private static void traceDecision(String videoId,
+                                      String decision,
+                                      String reason,
+                                      boolean autoDub,
+                                      int durationSeconds,
+                                      String path) {
+        if (!Settings.HUNTER_DEBUG_LOGS.get()) return;
+        HunterTraceLog.append(
+                "FILTER_DECISION",
+                "videoId=" + (videoId == null ? "?" : videoId)
+                        + "\ndecision=" + decision
+                        + "\nreason=" + reason
+                        + "\nautoDubAssociated=" + autoDub
+                        + "\ndurationSeconds=" + durationSeconds
+                        + "\npath=" + path
+        );
+    }
+
+    private static final class RecentCard {
+        final String videoId;
+        final String path;
+        final long seenAtMs;
+
+        RecentCard(String videoId, String path, long seenAtMs) {
+            this.videoId = videoId;
+            this.path = path;
+            this.seenAtMs = seenAtMs;
+        }
+    }
+}
